# Local Postgres for development and integration tests.
DATABASE_URL=postgres://barber:barber@127.0.0.1:5432/barber_dev

# Integration tests truncate every table, so they get their own database.
# The suite refuses to run unless this database name contains "test".
TEST_DATABASE_URL=postgres://barber:barber@127.0.0.1:5432/barber_test

# Signs the barber session and device-token cookies. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional: pin the app to one shop. Defaults to the oldest shop in the database.
SHOP_ID=

# Optional: set by Vercel Cron, checked by /api/cron/sweep.
CRON_SECRET=
